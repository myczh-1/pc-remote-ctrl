# Base domain and TinyAuth endpoints
ROOT_DOMAIN=localtest.me
TINYAUTH_URL=http://tinyauth.localtest.me

# Bootstrap users for TinyAuth (username:bcrypt_hash)
TINYAUTH_USERS=user:$$2y$$10$$your_bcrypt_hash_here

# Optional secrets and OAuth plumbing (uncomment if needed)
#TINYAUTH_SESSION_SECRET=change-me
#OAUTH_AUTO_REDIRECT=google
#PROVIDERS_GOOGLE_CLIENT_ID=
#PROVIDERS_GOOGLE_CLIENT_SECRET=
#OAUTH_WHITELIST=you@example.com, *@example.org

# Protected service upstreams (container URL form)
CLOUD_UPSTREAM=http://cloud:7073
FRONTEND_UPSTREAM=http://frontend:5173

